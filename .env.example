# ==============================================================================
# Kestrel Platform Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Kafka Broker Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_SCORED_TOPIC=transactions.scored
KAFKA_FRAUD_TOPIC=transactions.fraud
KAFKA_REVIEW_TOPIC=transactions.review
KAFKA_DLQ_TOPIC=transactions.dlq
KAFKA_CONSUMER_GROUP=kestrel-stream-processor-cg
KAFKA_PERSISTENCE_GROUP=kestrel-persistence-worker-cg

# Redis Feature Store & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT_SECONDS=2.0

# Database Configuration (PostgreSQL / SQLite Dual Mode)
# For local standalone execution without Docker: sqlite:///./kestrel.db
# For Docker Compose execution: postgresql+asyncpg://kestrel_user:kestrel_password@localhost:5432/kestrel_db
DATABASE_URL=sqlite+aiosqlite:///./kestrel.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# FastAPI Inference & Management Service
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
INFERENCE_URL=http://localhost:8000/api/v1/predict

# ML Model Configuration
ACTIVE_MODEL_VERSION=kestrel-hgb-v1.0.0
MODEL_ARTIFACTS_DIR=./ml/artifacts

# Decision Engine Policy Thresholds
THRESHOLD_APPROVE_MAX=0.30
THRESHOLD_BLOCK_MIN=0.75

# Transaction Generator Settings
GENERATOR_DEFAULT_TPS=15
GENERATOR_FRAUD_RATIO=0.02
GENERATOR_SEED=42

# Monitoring & Prometheus
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
